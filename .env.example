# =============================================================================
# SULEMAN ZAHEER — ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file as .env.local and fill in the values
# =============================================================================

# 1. GitHub Storage (Server-Side Secret - Never expose to client)
GITHUB_TOKEN=your_github_personal_access_token_here

# 2. Groq AI Engine (Vision & Automated SEO Generation)
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# 3. ImgBB API Key
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here

# 4. Frontend Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=suleman-zaheer
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=suleman-zaheer.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=suleman-zaheer.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# 5. EmailJS Configuration (Contact Form)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAILJS_AUTO_REPLY_TEMPLATE_ID=your_emailjs_auto_reply_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

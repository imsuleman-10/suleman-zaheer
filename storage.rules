rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // SEO Images: only authenticated admin can upload/delete, anyone can read (for public URL access)
    match /seo_images/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }

    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
